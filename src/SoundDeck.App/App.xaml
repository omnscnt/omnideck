<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SoundDeck.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SoundDeck.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Slider track: dimmer unfilled part, brighter filled part than the accent-based defaults. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SoundDeckTrackFill" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="SoundDeckTrackValueFill" Color="#FFAEAEAE" />
                    <SolidColorBrush x:Key="SoundDeckMeterTrack" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFBEBEBE" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF9E9E9E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SoundDeckTrackFill" Color="#26000000" />
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#33000000" />
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#26000000" />
                    <SolidColorBrush x:Key="SoundDeckTrackValueFill" Color="#FF5C5C5C" />
                    <SolidColorBrush x:Key="SoundDeckMeterTrack" Color="#14000000" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF4C4C4C" />
                    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF6C6C6C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Smaller slider thumb than the Fluent default (18 outer / 12 inner). -->
            <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
            <x:Double x:Key="SliderInnerThumbWidth">10</x:Double>
            <x:Double x:Key="SliderInnerThumbHeight">10</x:Double>
            <CornerRadius x:Key="SliderThumbCornerRadius">7</CornerRadius>

            <!-- Track colours are re-set here: the base style's setters resolve inside WinUI's own
                 dictionary, and WinUI's own SliderTrackFill keys win the lookup, hence our own key names. -->
            <Style TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
                <Setter Property="Background" Value="{ThemeResource SoundDeckTrackFill}" />
                <Setter Property="Foreground" Value="{ThemeResource SoundDeckTrackValueFill}" />
            </Style>

            <!-- Vertical level bar left of each row's icon: icon-high, ~40% of its width.
                 Keyed and set explicitly: an implicit style for it is not picked up inside the DataTemplate. -->
            <Style x:Key="LevelMeterStyle" TargetType="controls:LevelMeter">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="20" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource SoundDeckMeterTrack}" />
                <Setter Property="FillBrush" Value="{ThemeResource SoundDeckTrackValueFill}" />
            </Style>

            <!-- Small section captions ("Output", "Apps"). -->
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Subtle text button for the current output device (opens the device picker). -->
            <Style x:Key="DeviceButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Square transparent icon button (mute toggles, footer actions). -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
