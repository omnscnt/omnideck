<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Omnideck.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Omnideck.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Slider track: dimmer unfilled part, brighter filled part than the accent-based defaults. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="OmnideckTrackFill" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="OmnideckTrackValueFill" Color="#FFAEAEAE" />
                    <SolidColorBrush x:Key="OmnideckMeterTrack" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="OmnideckPaneStroke" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="OmnideckDashStroke" Color="#5CFFFFFF" />
                    <SolidColorBrush x:Key="OmnideckTitleForeground" Color="#FFC8C8C8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OmnideckTrackFill" Color="#26000000" />
                    <SolidColorBrush x:Key="OmnideckTrackValueFill" Color="#FF5C5C5C" />
                    <SolidColorBrush x:Key="OmnideckMeterTrack" Color="#14000000" />
                    <SolidColorBrush x:Key="OmnideckPaneStroke" Color="#14000000" />
                    <SolidColorBrush x:Key="OmnideckDashStroke" Color="#5C000000" />
                    <SolidColorBrush x:Key="OmnideckTitleForeground" Color="#FF5C5C5C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Smaller slider thumb than the Fluent default (18 outer / 12 inner). -->
            <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
            <x:Double x:Key="SliderInnerThumbWidth">10</x:Double>
            <x:Double x:Key="SliderInnerThumbHeight">10</x:Double>
            <CornerRadius x:Key="SliderThumbCornerRadius">7</CornerRadius>

            <!-- Track colours are re-set here: the base style's setters resolve inside WinUI's own
                 dictionary, and WinUI's own SliderTrackFill keys win the lookup, hence our own key names. -->
            <Style TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
                <Setter Property="Background" Value="{ThemeResource OmnideckTrackFill}" />
                <Setter Property="Foreground" Value="{ThemeResource OmnideckTrackValueFill}" />
            </Style>

            <!-- Vertical level bar left of each row's icon: icon-high, ~40% of its width.
                 Keyed and set explicitly: an implicit style for it is not picked up inside the DataTemplate. -->
            <Style x:Key="LevelMeterStyle" TargetType="controls:LevelMeter">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="20" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource OmnideckMeterTrack}" />
                <Setter Property="FillBrush" Value="{ThemeResource OmnideckTrackValueFill}" />
            </Style>

            <!-- Settings window: Windows 11 Settings-style row card. -->
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            </Style>

            <!-- One key of a shortcut, drawn as a key cap ("Ctrl" "+" ...). -->
            <Style x:Key="KeyCapStyle" TargetType="Border">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1,1,1,2" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <!-- Small section captions ("Output", "Apps"). -->
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Subtle text button for the current output device (opens the device picker). -->
            <Style x:Key="DeviceButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- One zone of a position picker (a rectangle split into zones): fills its cell, outlined on
                 hover. Background is the zone's fill (bright when selected, set in code). -->
            <Style x:Key="ScreenSlotButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Opacity" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Opacity" Value="1" />
                                                <Setter Target="Pill.Opacity" Value="0.7" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="4" />
                                <Border x:Name="Ring" BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" BorderThickness="1" CornerRadius="4" Opacity="0" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Square transparent icon button (mute toggles, footer actions). -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
