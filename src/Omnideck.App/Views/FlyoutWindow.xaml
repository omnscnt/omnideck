<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Omnideck.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Omnideck.Controls"
    xmlns:vm="using:Omnideck.ViewModels"
    Title="omnideck.">

    <!--
        Layout mirrors the Windows 11 quick-settings flyout:
        acrylic base → OUTPUT + device picker + master slider, divider, APPS card with per-app rows, footer.
        Every slider row shares the same four columns: level meter | icon button (mute) | slider | percent.
    -->
    <Grid x:Name="RootGrid" KeyDown="OnRootKeyDown">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Themes/SliderColors.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!-- The device picker: a compact list no wider than its button (or a little, for an icon). -->
                <Style x:Key="PickerPresenterStyle" TargetType="FlyoutPresenter">
                    <Setter Property="Padding" Value="3" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="MaxWidth" Value="1000" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="IsDefaultShadowEnabled" Value="False" />
                    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                </Style>
                <!-- An app's output button: outlined, quiet fill, in both the narrow and the wide mixer. -->
                <Style x:Key="OutputButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="CornerRadius" Value="5" />
                    <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                </Style>
                <Style x:Key="PickerItemStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="6,0,8,0" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid x:Name="Card" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Master volume, on the base layer -->
            <StackPanel Padding="{x:Bind ViewModel.MasterPadding, Mode=OneWay}">
                <!-- "Output" label + current device, which opens the device picker -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionLabelStyle}" Text="OUTPUT" />
                    <Button
                        Grid.Column="1"
                        Margin="0,0,-6,0"
                        HorizontalAlignment="Right"
                        Click="OnOutputClick"
                        Style="{StaticResource DeviceButtonStyle}"
                        AutomationProperties.Name="Output device"
                        ToolTipService.ToolTip="Choose output device">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                MaxWidth="230"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.Master.DeviceName, Mode=OneWay, FallbackValue='No output device'}"
                                TextTrimming="CharacterEllipsis" />
                            <FontIcon VerticalAlignment="Center" FontSize="10" Glyph="&#xE70D;" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.MasterVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <controls:LevelMeter Margin="0,0,-2,0" Style="{StaticResource LevelMeterStyle}" Level="{x:Bind ViewModel.Master.Level, Mode=OneWay, FallbackValue=0}" />
                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.Master.ToggleMuteCommand, Mode=OneWay}"
                        Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Mute output"
                        ToolTipService.ToolTip="Mute">
                        <FontIcon FontSize="16" Glyph="{x:Bind ViewModel.Master.Glyph, Mode=OneWay, FallbackValue=''}" />
                    </Button>
                    <Slider
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        controls:HoverThumb.IsEnabled="True"
                        IsThumbToolTipEnabled="False"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="1"
                        Value="{x:Bind ViewModel.Master.Volume, Mode=TwoWay, FallbackValue=0}" />
                    <TextBlock
                        Grid.Column="3"
                        HorizontalTextAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,0,2"
                        Text="{x:Bind ViewModel.Master.PercentText, Mode=OneWay, FallbackValue=''}" />
                </Grid>
                <TextBlock
                    Margin="6,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No output device found"
                    Visibility="{x:Bind ViewModel.NoDeviceVisibility, Mode=OneWay}" />

                <!-- Divider spans the same width as the app cards below. -->
                <Border Height="1" Margin="-11,10,-13,8" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionLabelStyle}" Text="APPS" />
                    <!-- Widens the mixer: each app's output device by name. -->
                    <Button
                        Width="24"
                        Height="24"
                        Margin="0,-4,-6,-4"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.ToggleExpandedCommand}"
                        Visibility="{x:Bind ViewModel.OutputsVisibility, Mode=OneWay}"
                        Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="{x:Bind ViewModel.ExpandToolTip, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ExpandToolTip, Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="{x:Bind ViewModel.ExpandGlyph, Mode=OneWay}" />
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Apps: one raised rounded card per app, inset from the window edges -->
            <Grid Grid.Row="1" Margin="8,0">
                <TextBlock
                    Margin="13,8"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="No apps are playing audio right now"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}" />

                <ScrollViewer x:Name="AppsScroller" Margin="0,0,-12,0" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AppsList" ItemsSource="{x:Bind ViewModel.Apps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppVolumeViewModel">
                                <Border
                                    Padding="{x:Bind RowPadding, Mode=OneWay}"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{ThemeResource OverlayCornerRadius}">                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <controls:LevelMeter Margin="0,0,-2,0" Style="{StaticResource LevelMeterStyle}" Level="{x:Bind Level, Mode=OneWay}" />

                                        <!-- The app icon is the mute toggle. -->
                                        <Button
                                            Grid.Column="1"
                                            Command="{x:Bind ToggleMuteCommand}"
                                            Style="{StaticResource IconButtonStyle}"
                                            AutomationProperties.Name="{x:Bind Name}"
                                            ToolTipService.ToolTip="{x:Bind Name}">
                                            <Grid Width="20" Height="20">
                                                <Grid Opacity="{x:Bind ContentOpacity, Mode=OneWay}">
                                                    <Image Width="20" Height="20" Source="{x:Bind Icon, Mode=OneWay}" />
                                                    <FontIcon FontSize="16" Glyph="{x:Bind FallbackGlyph}" Visibility="{x:Bind FallbackIconVisibility, Mode=OneWay}" />
                                                </Grid>
                                                <Border
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,-5,-5"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                    CornerRadius="7"
                                                    Visibility="{x:Bind MutedVisibility, Mode=OneWay}">
                                                    <FontIcon FontSize="9" Glyph="&#xE74F;" />
                                                </Border>                                            </Grid>
                                        </Button>

                                        <Slider
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            controls:HoverThumb.IsEnabled="True"
                        IsThumbToolTipEnabled="False"
                                            Maximum="100"
                                            Minimum="0"
                                            StepFrequency="1"
                                            Value="{x:Bind Volume, Mode=TwoWay}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            HorizontalTextAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,0,2"
                                            Text="{x:Bind PercentText, Mode=OneWay}" />

                                        <!-- Where it plays: an icon, or (wide mixer) the device's name. Opens the device picker. -->
                                        <Border Grid.Column="4" Margin="4,0,0,0" Width="{x:Bind OutputButtonWidth, Mode=OneWay}" Visibility="{x:Bind OutputColumnVisibility, Mode=OneWay}">
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Click="OnAppOutputClick"
                                                Style="{StaticResource OutputButtonStyle}"
                                                Height="28"
                                                Padding="6,0"
                                                Visibility="{x:Bind OutputButtonVisibility}"
                                                AutomationProperties.Name="Output device"
                                                ToolTipService.ToolTip="{x:Bind OutputToolTip, Mode=OneWay}">
                                                <Grid Opacity="{x:Bind OutputOpacity, Mode=OneWay}">
                                                    <FontIcon HorizontalAlignment="Center" FontSize="14" Glyph="&#xE7F5;" Opacity="{x:Bind OutputIconOpacity, Mode=OneWay}" />
                                                    <Grid ColumnSpacing="4" Opacity="{x:Bind OutputNameOpacity, Mode=OneWay}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind OutputLabel, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <FontIcon Grid.Column="1" VerticalAlignment="Center" FontSize="10" Glyph="&#xE70D;" />
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Footer, on the base layer -->
            <Grid Grid.Row="2" Height="48" Padding="8,0">
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OnSettingsClick"
                    Style="{StaticResource IconButtonStyle}"
                    AutomationProperties.Name="Settings"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
