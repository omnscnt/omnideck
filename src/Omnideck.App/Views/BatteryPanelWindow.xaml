<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Omnideck.Views.BatteryPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Omnideck.ViewModels"
    Title="omnideck. devices">

    <!-- A separate plaque over the mixer, like the media flyout over Windows 11's quick settings:
         a chip per wireless device with its charge. Placed, shown and slid by the mixer's window. -->
    <Grid x:Name="RootGrid" Padding="8,10">
        <ItemsControl x:Name="ChipsList" HorizontalAlignment="Left" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BatteryChip">
                    <Border
                        Height="28"
                        Padding="8,0,9,0"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        ToolTipService.ToolTip="{x:Bind ToolTip}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="{x:Bind Glyph}" />
                            <TextBlock Margin="0,0,0,1" VerticalAlignment="Center" Foreground="{x:Bind LevelBrush}" Text="{x:Bind LevelText}" />
                            <FontIcon Margin="-3,0,0,0" FontSize="11" Glyph="&#xE945;" Visibility="{x:Bind ChargingVisibility}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
