<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Omnideck.Views.HotkeyEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Omnideck.ViewModels">

    <!-- The expanded part of a hotkey card. Changes apply as soon as the hotkey is valid. -->
    <StackPanel Padding="16,14,16,16" Spacing="14">

        <!-- Shortcut: click, then press the combination -->
        <StackPanel>
            <TextBlock Margin="0,0,0,8" Text="Shortcut" />
            <Button
                x:Name="RecordButton"
                MinHeight="36"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                AutomationProperties.Name="Shortcut"
                Click="OnRecordClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="RecordIcon" FontSize="14" Glyph="&#xE765;" />
                    <TextBlock x:Name="RecordText" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="TriggerBox" HorizontalAlignment="Stretch" Header="Trigger" SelectionChanged="OnFieldChanged">
                <x:String>Press</x:String>
                <x:String>Double press</x:String>
                <x:String>Triple press</x:String>
                <x:String>Press and hold</x:String>
            </ComboBox>
            <ComboBox x:Name="ActionBox" Grid.Column="1" HorizontalAlignment="Stretch" Header="Action" SelectionChanged="OnFieldChanged">
                <x:String>Volume up</x:String>
                <x:String>Volume down</x:String>
                <x:String>Mute / unmute</x:String>
                <x:String>Play / pause</x:String>
                <x:String>Next track</x:String>
                <x:String>Previous track</x:String>
                <x:String>Open mixer</x:String>
                <x:String>Mute / unmute microphone</x:String>
            </ComboBox>
            <ComboBox x:Name="TargetBox" Grid.Column="2" HorizontalAlignment="Stretch" Header="Target" SelectionChanged="OnFieldChanged">
                <x:String>Master volume</x:String>
                <x:String>Active window</x:String>
                <x:String>Media player</x:String>
                <x:String>Specific app</x:String>
                <x:String>All except active</x:String>
            </ComboBox>
        </Grid>

        <Grid x:Name="ExtraRow" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <NumberBox
                x:Name="StepBox"
                Header="Step, %"
                LargeChange="5"
                Maximum="50"
                Minimum="1"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValueChanged="OnStepChanged" />
            <ComboBox
                x:Name="AppBox"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Header="App (process name)"
                IsEditable="True"
                PlaceholderText="e.g. spotify"
                KeyUp="OnAppKeyUp"
                TextSubmitted="OnAppTextSubmitted"
                SelectionChanged="OnFieldChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:WidgetAppItem">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Image Source="{x:Bind Icon, Mode=OneWay}" />
                                <FontIcon FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE71D;" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <CheckBox x:Name="BlockBox" Content="Block this key for other apps" Click="OnBlockClick" />

        <TextBlock
            x:Name="StatusText"
            Margin="0,-6,0,0"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
