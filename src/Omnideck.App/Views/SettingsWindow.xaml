<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Omnideck.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Omnideck.ViewModels"
    xmlns:views="using:Omnideck.Views"
    Title="omnideck. Settings">

    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="ms-appx:///Themes/SliderColors.xaml" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (content extends into it) -->
        <Grid x:Name="TitleBar" Height="32" Padding="8,0,0,0">
            <!-- Wordmark in Outfit Bold (bundled, OFL: Assets/Fonts), level with the caption buttons, and the
                 version after it in the same font, smaller and dimmer, on the same baseline (set in code). -->
            <TextBlock
                Margin="0,4,0,0"
                VerticalAlignment="Top"
                FontFamily="ms-appx:///Assets/Fonts/Outfit.ttf#Outfit"
                FontSize="18"
                FontWeight="Bold"
                Foreground="{ThemeResource OmnideckTitleForeground}">
                <Run Text="omnideck." /><Run x:Name="VersionRun" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </TextBlock>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            CompactPaneLength="64"
            OpenPaneLength="216"
            PaneDisplayMode="Left"
            ItemInvoked="OnNavItemInvoked"
            SelectionChanged="OnNavSelectionChanged">
            <!-- The tab pane is a floating rounded card (drawn in code-behind, see FloatPane); the content
                 sits directly on the Mica base with no layer or border of its own. -->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <!-- Items inset to sit inside the floating pane card (8 px inset + 4 px gap). -->
                <Thickness x:Key="NavigationViewItemButtonMargin">12,2</Thickness>
                <!-- That margin also pushes the icon column; pull icons back so they centre in their highlight. -->
                <Thickness x:Key="NavigationViewItemOnLeftIconBoxMargin">-16,0,0,0</Thickness>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <!-- Hamburger as a non-selecting item: same highlight and icon column as the tabs. -->
                <NavigationViewItem x:Name="MenuToggleItem" AutomationProperties.Name="Toggle navigation" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE700;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="HotkeysItem" Content="Hotkeys" Tag="hotkeys">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Taskbar widget" Tag="widget">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Volume indicator" Tag="osd">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE767;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <!-- General settings sit at the bottom of the pane, where Windows puts Settings. -->
            <NavigationView.FooterMenuItems>
                <!-- Lifted so its highlight keeps the same 3 px gap to the card's bottom edge as the top item has. -->
                <NavigationViewItem Margin="0,0,0,7" Content="General" Tag="general">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid x:Name="PageHost" SizeChanged="OnPageHostSizeChanged">
                <!-- Hotkeys page: a ListView for its scrolling; cards are reordered by our own drag (SettingsWindow.Reorder). -->
                <ListView
                    x:Name="HotkeysPage"
                    VerticalAlignment="Top"
                    Padding="36,8,36,36"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind Hotkeys.Items}"
                    SelectionMode="None">
                    <ListView.Header>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8" Style="{StaticResource TitleTextBlockStyle}" Text="Hotkeys" />
                            <TextBlock
                                Margin="0,0,0,16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Bind a key to a volume or media action. One key can carry several bindings: press (repeats while held), double press and triple press. Drag cards to reorder."
                                TextWrapping="Wrap" />

                            <!-- Same size as a card, dashed: the new hotkey unfolds right below it. -->
                            <Button
                                x:Name="AddButton"
                                Height="68"
                                Margin="0,0,0,4"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                AutomationProperties.Name="Add hotkey"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnAddClick"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                                <Grid>
                                    <Rectangle
                                        RadiusX="8"
                                        RadiusY="8"
                                        Stroke="{ThemeResource OmnideckDashStroke}"
                                        StrokeDashArray="4,3"
                                        StrokeThickness="1" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE710;" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Add hotkey" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ListView.Header>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                            <!-- Bare container: the card draws its own surface and hover. -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                            <ContentPresenter
                                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                ContentTransitions="{TemplateBinding ContentTransitions}" />
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:HotkeyItemViewModel">
                            <views:HotkeyCard Item="{x:Bind}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Taskbar widget page -->
                <ScrollViewer x:Name="WidgetPage" Visibility="Collapsed">
                <Grid x:Name="WidgetContent" Padding="36,8,36,36">
                    <StackPanel Spacing="4">
                        <TextBlock Margin="0,0,0,8" Style="{StaticResource TitleTextBlockStyle}" Text="Taskbar widget" />
                        <TextBlock
                            Margin="0,0,0,16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="What's playing, right on the taskbar. Click the title to bring the player forward."
                            TextWrapping="Wrap" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Show the widget" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Hidden while no app is playing media; a paused track stays, dimmed." />
                                </StackPanel>
                                <ToggleSwitch x:Name="WidgetSwitch" MinWidth="0" OffContent="" OnContent="" Grid.Column="1" HorizontalAlignment="Right" AutomationProperties.Name="Show the widget" Toggled="OnWidgetChanged" />
                            </Grid>
                        </Border>

                        <TextBlock Margin="2,20,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Placement and look" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Position" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="With a left-aligned taskbar, the left positions move just after the app icons." />
                                </StackPanel>
                                <ComboBox x:Name="WidgetPositionBox" MinWidth="200" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Position" SelectionChanged="OnWidgetChanged">
                                    <x:String>Left</x:String>
                                    <x:String>Before the app icons</x:String>
                                    <x:String>After the app icons</x:String>
                                    <x:String>Right, next to the tray</x:String>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Offset" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Fine-tunes the position, in pixels: negative moves left." />
                                </StackPanel>
                                <NumberBox x:Name="WidgetOffsetBox" MinWidth="140" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Offset"
                                    LargeChange="10" Maximum="1000" Minimum="-1000" SmallChange="2" SpinButtonPlacementMode="Inline" ValueChanged="OnWidgetNumberChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Size" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Small shows the title only." />
                                </StackPanel>
                                <ComboBox x:Name="WidgetSizeBox" MinWidth="200" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Size" SelectionChanged="OnWidgetChanged">
                                    <x:String>Small</x:String>
                                    <x:String>Medium</x:String>
                                    <x:String>Large</x:String>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Text width" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="The widget keeps this width for every track, so the buttons stay in place." />
                                </StackPanel>
                                <NumberBox x:Name="WidgetWidthBox" MinWidth="140" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Text width"
                                    LargeChange="20" Maximum="500" Minimum="60" SmallChange="10" SpinButtonPlacementMode="Inline" ValueChanged="OnWidgetNumberChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Playback buttons" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Previous, play / pause and next beside the title." />
                                </StackPanel>
                                <ToggleSwitch x:Name="WidgetControlsSwitch" MinWidth="0" OffContent="" OnContent="" Grid.Column="1" HorizontalAlignment="Right" AutomationProperties.Name="Playback buttons" Toggled="OnWidgetChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Dim when paused" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Fades the whole widget while the track is paused; hovering brings it back." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                                    <Slider x:Name="WidgetDimSlider" Width="180" VerticalAlignment="Center" AutomationProperties.Name="Dim when paused"
                                        Maximum="80" Minimum="0" StepFrequency="5" ValueChanged="OnWidgetSliderChanged" />
                                    <TextBlock x:Name="WidgetDimText" Width="36" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Scroll long titles" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Titles that don't fit scroll by instead of ending in an ellipsis." />
                                </StackPanel>
                                <ToggleSwitch x:Name="WidgetScrollSwitch" MinWidth="0" OffContent="" OnContent="" Grid.Column="1" HorizontalAlignment="Right" AutomationProperties.Name="Scroll long titles" Toggled="OnWidgetChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hide in fullscreen" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="The widget disappears while a video or game fills the screen." />
                                </StackPanel>
                                <ToggleSwitch x:Name="WidgetFullscreenSwitch" MinWidth="0" OffContent="" OnContent="" Grid.Column="1" HorizontalAlignment="Right" AutomationProperties.Name="Hide in fullscreen" Toggled="OnWidgetChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Cover backdrop" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="The album art, blurred, behind the widget." />
                                </StackPanel>
                                <ToggleSwitch x:Name="WidgetBackdropSwitch" MinWidth="0" OffContent="" OnContent="" Grid.Column="1" HorizontalAlignment="Right" AutomationProperties.Name="Cover backdrop" Toggled="OnWidgetChanged" />
                            </Grid>
                        </Border>

                        <TextBlock Margin="2,20,0,6" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Apps" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Show media from" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Choose which apps the widget may follow." />
                                </StackPanel>
                                <ComboBox x:Name="WidgetFilterBox" MinWidth="200" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Show media from" SelectionChanged="OnWidgetChanged">
                                    <x:String>All apps</x:String>
                                    <x:String>Only the apps below</x:String>
                                    <x:String>All except the apps below</x:String>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="WidgetAppsPanel" Spacing="4">
                            <ItemsControl x:Name="WidgetAppsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WidgetAppItem">
                                        <Border MinHeight="48" Padding="16,6,8,6" Style="{StaticResource SettingsCardStyle}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                                    <Image Source="{x:Bind Icon, Mode=OneWay}" />
                                                    <FontIcon FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE71D;" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Name}" />
                                                <Button Grid.Column="2" AutomationProperties.Name="Remove" Click="OnWidgetAppRemove" Style="{StaticResource IconButtonStyle}" Tag="{x:Bind}">
                                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="WidgetAppBox"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="App to add"
                                        DropDownOpened="OnWidgetAppBoxOpened"
                                        IsEditable="True"
                                        PlaceholderText="App name, e.g. spotify, chrome, msedge">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WidgetAppItem">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                                                        <Image Source="{x:Bind Icon, Mode=OneWay}" />
                                                        <FontIcon FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE71D;" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                                    </Grid>
                                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Click="OnWidgetAppAdd" Content="Add" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                </ScrollViewer>

                <!-- Volume indicator page -->
                <ScrollViewer x:Name="OsdPage" Visibility="Collapsed">
                <Grid x:Name="OsdContentGrid" Padding="36,8,36,36">
                    <StackPanel Spacing="4">
                        <TextBlock Margin="0,0,0,8" Style="{StaticResource TitleTextBlockStyle}" Text="Volume indicator" />
                        <TextBlock
                            Margin="0,0,0,16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="A small, unclickable bar that shows the new volume when a hotkey changes it, for the whole device or a single app."
                            TextWrapping="Wrap" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Show the volume indicator" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Appears on the screen with the mouse pointer." />
                                </StackPanel>
                                <ToggleSwitch x:Name="OsdSwitch" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" HorizontalAlignment="Right" AutomationProperties.Name="Show the volume indicator" Toggled="OnOsdChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Position" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Where on the screen it appears. Click a spot to see it there." />
                                </StackPanel>
                                <!-- Position picker: the screen as a rectangle split into the six zones the indicator can take. -->
                                <Grid
                                    x:Name="OsdPositionPicker"
                                    Grid.Column="1"
                                    Width="108"
                                    Height="60"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ColumnSpacing="2"
                                    RowSpacing="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button AutomationProperties.Name="Top left" Click="OnOsdSlotClick" Style="{StaticResource ScreenSlotButtonStyle}" Tag="TopLeft" />
                                    <Button Grid.Column="1" AutomationProperties.Name="Top centre" Click="OnOsdSlotClick" Style="{StaticResource ScreenSlotButtonStyle}" Tag="TopCenter" />
                                    <Button Grid.Column="2" AutomationProperties.Name="Top right" Click="OnOsdSlotClick" Style="{StaticResource ScreenSlotButtonStyle}" Tag="TopRight" />
                                    <Button Grid.Row="1" AutomationProperties.Name="Bottom left" Click="OnOsdSlotClick" Style="{StaticResource ScreenSlotButtonStyle}" Tag="BottomLeft" />
                                    <Button Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Bottom centre" Click="OnOsdSlotClick" Style="{StaticResource ScreenSlotButtonStyle}" Tag="BottomCenter" />
                                    <Button Grid.Row="1" Grid.Column="2" AutomationProperties.Name="Bottom right" Click="OnOsdSlotClick" Style="{StaticResource ScreenSlotButtonStyle}" Tag="BottomRight" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Width" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Length of the indicator; the bar takes up the extra room." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                                    <Slider x:Name="OsdWidthSlider" Width="180" VerticalAlignment="Center" AutomationProperties.Name="Width"
                                        Maximum="480" Minimum="160" StepFrequency="8" ValueChanged="OnOsdSliderChanged" />
                                    <TextBlock x:Name="OsdWidthText" Width="36" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Height" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="The icon, bar and number grow with it." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                                    <Slider x:Name="OsdHeightSlider" Width="180" VerticalAlignment="Center" AutomationProperties.Name="Height"
                                        Maximum="72" Minimum="32" StepFrequency="2" ValueChanged="OnOsdSliderChanged" />
                                    <TextBlock x:Name="OsdHeightText" Width="36" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Backing" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="How far the backing reaches past the icon, bar and number. Negative hugs them closer." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                                    <Slider x:Name="OsdBackingSlider" Width="180" VerticalAlignment="Center" AutomationProperties.Name="Backing"
                                        Maximum="24" Minimum="-8" StepFrequency="1" ValueChanged="OnOsdSliderChanged" />
                                    <TextBlock x:Name="OsdBackingText" Width="36" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Corner rounding" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="From square corners to a fully round pill." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                                    <Slider x:Name="OsdCornerSlider" Width="180" VerticalAlignment="Center" AutomationProperties.Name="Corner rounding"
                                        Maximum="100" Minimum="0" StepFrequency="5" ValueChanged="OnOsdSliderChanged" />
                                    <TextBlock x:Name="OsdCornerText" Width="40" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Number size" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Size of the volume percentage next to the bar." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                                    <Slider x:Name="OsdTextSlider" Width="180" VerticalAlignment="Center" AutomationProperties.Name="Number size"
                                        Maximum="24" Minimum="10" StepFrequency="1" ValueChanged="OnOsdSliderChanged" />
                                    <TextBlock x:Name="OsdTextText" Width="40" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>


                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Duration" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="How long it stays after the last change." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                                    <Slider x:Name="OsdDurationSlider" Width="180" VerticalAlignment="Center" AutomationProperties.Name="Duration"
                                        Maximum="5" Minimum="0.5" StepFrequency="0.5" ValueChanged="OnOsdSliderChanged" />
                                    <TextBlock x:Name="OsdDurationText" Width="36" VerticalAlignment="Center" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Also show other changes" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Media keys, the Windows mixer and apps changing their own volume. Not the omnideck mixer: its sliders already show it." />
                                </StackPanel>
                                <ToggleSwitch x:Name="OsdExternalSwitch" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" HorizontalAlignment="Right" AutomationProperties.Name="Also show other changes" Toggled="OnOsdChanged" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Preview" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Shows the indicator with the current master volume." />
                                </StackPanel>
                                <Button Grid.Column="1" HorizontalAlignment="Right" Click="OnOsdPreview" Content="Show" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
                </ScrollViewer>

                <!-- General page -->
                <ScrollViewer x:Name="GeneralPage" Visibility="Collapsed">
                <Grid x:Name="GeneralContent" Padding="36,8,36,36">
                    <StackPanel Spacing="4">
                        <TextBlock Margin="0,0,0,16" Style="{StaticResource TitleTextBlockStyle}" Text="General" />

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Start with Windows" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Starts quietly in the notification area when you sign in." />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AutoStartSwitch"
                                    MinWidth="0"
                                    Grid.Column="1" HorizontalAlignment="Right"
                                    AutomationProperties.Name="Start with Windows"
                                    Toggled="OnAutoStartToggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Windows sound settings" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Devices, formats and the system volume mixer." />
                                </StackPanel>
                                <Button Grid.Column="1" HorizontalAlignment="Right" Click="OnWindowsSoundClick" Content="Open" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Updates" />
                                    <TextBlock
                                        x:Name="UpdateStatusText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                    <ProgressBar x:Name="UpdateProgress" Margin="0,8,0,0" Maximum="1" Visibility="Collapsed" />
                                </StackPanel>
                                <Button x:Name="UpdateButton" Grid.Column="1" HorizontalAlignment="Right" Click="OnUpdateClick" Content="Check for updates" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Check for updates automatically" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        Text="Looks for a new version on GitHub once a day and lets you know in the notification area." />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="AutoUpdateSwitch"
                                    MinWidth="0"
                                    Grid.Column="1" HorizontalAlignment="Right"
                                    AutomationProperties.Name="Check for updates automatically"
                                    Toggled="OnAutoUpdateToggled" />
                            </Grid>
                        </Border>

                        <TextBlock
                            x:Name="SettingsPathText"
                            Margin="2,12,0,0"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
