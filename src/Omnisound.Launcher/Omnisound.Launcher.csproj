<Project Sdk="Microsoft.NET.Sdk">

  <!-- The omnisound.exe at the top of a release folder: starts app\omnisound.exe and exits, so the folder
       holds this file and app\ instead of hundreds of runtime files. .NET Framework 4.8 ships with
       Windows, so it needs nothing beside it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>omnisound</AssemblyName>
    <RootNamespace>Omnisound.Launcher</RootNamespace>
    <AssemblyTitle>omnisound.</AssemblyTitle>
    <Product>omnisound.</Product>
    <Version>0.2.0</Version>
    <ApplicationIcon>..\Omnisound.App\Assets\omnisound.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <GenerateAppConfig>false</GenerateAppConfig>
  </PropertyGroup>

</Project>
